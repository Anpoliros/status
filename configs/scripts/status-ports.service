# Dedicated local traffic counters; application processes remain unprivileged.
[Unit]
Description=Status local service traffic counters
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/status-ports/port-counters.py
Restart=on-failure
RestartSec=5
RuntimeDirectory=status-ports
RuntimeDirectoryMode=0755
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/status-ports

[Install]
WantedBy=multi-user.target
